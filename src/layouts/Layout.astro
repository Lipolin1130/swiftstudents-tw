---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPaths, useTranslations } from '../i18n/utils';
import { SITE } from '../config';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
}
const { lang, title, description, image } = Astro.props;
const t = useTranslations(lang);

const abs = (path: string) => new URL(path, SITE.url).href.replace(/\/$/, '') || SITE.url;
const canonical = abs(Astro.url.pathname);
const paths = localizedPaths(Astro.url.pathname);
const zhHref = abs(paths['zh-Hant']);
const enHref = abs(paths.en);
const htmlLang = lang === 'en' ? 'en' : 'zh-Hant';
const ogImage = image ? new URL(image, SITE.url).href : undefined;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

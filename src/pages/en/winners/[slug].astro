---
import WinnerDetailContent from '../../../components/pages/WinnerDetailContent.astro';
import { getWinnersByLang, winnerSlug } from '../../../lib/winners';

export async function getStaticPaths() {
  const winners = await getWinnersByLang('en');
  return winners.map((entry) => ({ params: { slug: winnerSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---
<WinnerDetailContent lang="en" entry={entry} />

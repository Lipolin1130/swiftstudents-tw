---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { SITE } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero">
  <div class="container">
    <h1 class="hero__title">{SITE.name}</h1>
    <p class="hero__tagline muted">{t('hero.tagline')}<br />{t('hero.tagline2')}</p>
  </div>
</section>
<style>
  .hero { padding-block: clamp(4rem, 12vw, 9rem) var(--space-4); text-align: center; }
  .hero__title { font-size: var(--fs-hero); max-width: 16ch; margin-inline: auto; }
  .hero__tagline { font-size: clamp(1.1rem, 2.5vw, 1.5rem); margin-top: var(--space-2); max-width: 46ch; margin-inline: auto; }
</style>

---
import { clubs } from '../data/clubs';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="clubs" aria-labelledby="clubs-heading">
  <div class="container">
    <h2 id="clubs-heading" class="clubs__heading">{t('clubs.heading')}</h2>
    <ul class="clubs__row">
      {clubs.map((c) => {
        const Tag = c.url ? 'a' : 'div';
        return (
          <li>
            <Tag class="clubs__item" href={c.url} target={c.url ? '_blank' : undefined} rel={c.url ? 'noopener' : undefined}>
              <img class="clubs__logo" src={c.logo} alt="" width="160" height="160" loading="lazy" />
              <span class="clubs__name">{c.name}</span>
              <span class="clubs__school muted">{c.school[lang]}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>
<style>
  .clubs { padding-block: var(--space-4) var(--space-6); text-align: center; }
  .clubs__heading { font-size: var(--fs-small); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); }
  .clubs__row {
    list-style: none; padding: 0; margin: var(--space-6) auto 0; max-width: 720px;
    display: grid; grid-template-columns: repeat(3, 1fr); align-items: end; gap: var(--space-2);
  }
  .clubs__row > li:nth-child(2) { transform: translateY(calc(-1 * var(--space-4))); }
  .clubs__item {
    display: flex; flex-direction: column; align-items: center; gap: 0.2rem;
    color: inherit; text-decoration: none;
  }
  .clubs__logo {
    width: clamp(84px, 24vw, 160px); height: auto; aspect-ratio: 1;
    border-radius: 50%; object-fit: cover;
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-1);
    transition: transform 0.2s ease;
  }
  a.clubs__item:hover .clubs__logo { transform: scale(1.04); }
  .clubs__name { font-weight: 600; }
  .clubs__school { font-size: var(--fs-small); }
  @media (prefers-reduced-motion: reduce) { .clubs__logo { transition: none; } }
</style>

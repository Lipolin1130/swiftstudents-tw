---
import Layout from '../../layouts/Layout.astro';
import PersonCard from '../PersonCard.astro';
import { getWinnersByLang, winnerPath, type WinnerEntry } from '../../lib/winners';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const winners = await getWinnersByLang(lang);
const winnersByYear = new Map<number, WinnerEntry[]>();
for (const w of winners) {
  winnersByYear.set(w.data.year, [...(winnersByYear.get(w.data.year) ?? []), w]);
}
const years = [...winnersByYear.keys()].sort((a, b) => b - a);
---
<Layout lang={lang} title={t('meta.community_title')} description={t('meta.community_desc')}>
  <section class="section">
    <div class="container">
      <div class="community__intro">
        <h1>{t('community_page.winners_heading')}</h1>
        <p class="muted">{t('community_page.winners_desc')}</p>
      </div>
      {years.length > 0
        ? years.map((year) => (
            <div class="community__year">
              <h2>{year}</h2>
              <ul class="community__grid">
                {winnersByYear.get(year)!.map((w) => (
                  <li>
                    <PersonCard
                      name={w.data.name}
                      photo={w.data.photo}
                      photoPosition={w.data.photoPosition}
                      href={winnerPath(w, lang)}
                      note={w.data.project}
                      badge={w.data.distinguished ? t('community_page.distinguished') : undefined}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))
        : <p class="muted community__empty">{t('community_page.empty')}</p>}
    </div>
  </section>
</Layout>
<style>
  .section { text-align: center; }
  .community__intro p { max-width: 52ch; margin: var(--space-2) auto 0; }
  @media (min-width: 640px) { .community__intro h1 { white-space: nowrap; } }
  .community__year { margin-top: var(--space-6); }
  .community__year h2 { font-size: var(--fs-h3); color: var(--color-text-muted); font-weight: 600; }
  .community__grid {
    list-style: none; padding: 0; margin: var(--space-4) 0 0;
    display: grid; gap: var(--space-4) var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }
  .community__empty { margin-top: var(--space-4); }
</style>
